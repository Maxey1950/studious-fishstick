{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Web Extension",
      "type": "extensionHost",
      "debugWebWorkerHost": true,
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentKind=web",
        "${workspaceFolder}/sample"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
