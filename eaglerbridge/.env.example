# Copy to .env and fill in before running `docker compose up`.
#
# NOTE: only GATEWAY_PORT and VIAPROXY_BIND_PORT are actually consumed by
# docker-compose.yml. TARGET_SERVER_HOST/PORT and CLIENT_PROTOCOL_VERSION
# below are NOT auto-injected into the generated EaglerXServer/ViaProxy
# configs (both are generated files you edit by hand per the README) — they
# exist here so the real values you're using live in one place you can copy
# from, not because compose reads them.

# Port the browser client's wss:// connects to (Velocity's own bind, shared
# by EaglerXServer via dual-stack sniffing — see docs/ARCHITECTURE.md §5a).
GATEWAY_PORT=8080

# Local port ViaProxy listens on; Velocity's [servers] entry must point here.
VIAPROXY_BIND_PORT=25568

# The real, offline-mode target server. Copy into viaproxy's generated
# viaproxy.yml as `target-address`.
TARGET_SERVER_HOST=play.example-server.net
TARGET_SERVER_PORT=25565

# Native protocol the Eaglercraft client speaks (NOT the marketing version
# string). Client source isn't available; this is set to EaglercraftX
# 26.1.2's confirmed protocol number as a working assumption. If the
# connection fails at handshake, check this first — see
# docs/ARCHITECTURE.md section 5, item 1. Copy into both
# gateway/plugins/EaglerXServer/settings.toml (max_minecraft_protocol) and
# viaproxy's generated config.
CLIENT_PROTOCOL_VERSION=775
