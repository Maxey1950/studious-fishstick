{
  "name": "blocks-editor-web",
  "displayName": "Blocks Editor (.blocks)",
  "description": "Visual Blockly editor for MakeCode .blocks files. Runs in vscode.dev and co-edits over Live Share.",
  "version": "0.0.4",
  "publisher": "maxey1950",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "blockly",
    "makecode",
    "blocks",
    "live share",
    "web"
  ],
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "blocks-xml",
        "aliases": [
          "Blocks (Blockly XML)"
        ],
        "extensions": [
          ".blocks"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blocks-xml",
        "scopeName": "text.xml",
        "path": "./syntaxes/blocks-xml.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "blocksEditor.blocks",
        "displayName": "Blocks Editor",
        "selector": [
          {
            "filenamePattern": "*.blocks"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "blocksEditor.openAsText",
        "title": "Blocks: Open Active File as XML Text"
      },
      {
        "command": "blocksEditor.openAsBlocks",
        "title": "Blocks: Open Active File in Blocks Editor"
      }
    ],
    "configuration": {
      "title": "Blocks Editor",
      "properties": {
        "blocksEditor.writeDebounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 5000,
          "description": "How long to wait after the last block change before writing back to the file. Lower values feel more live over Live Share but produce more document revisions."
        },
        "blocksEditor.renderer": {
          "type": "string",
          "enum": [
            "pxt",
            "zelos",
            "geras",
            "thrasos"
          ],
          "default": "pxt",
          "description": "Which renderer draws the blocks.",
          "enumDescriptions": [
            "MakeCode's own renderer, ported from pxt. Blocks get the exact geometry the Arcade editor draws.",
            "Blockly’s rounded renderer, which pxt’s is derived from.",
            "Blockly’s classic renderer.",
            "Blockly’s thin renderer."
          ]
        },
        "blocksEditor.engine": {
          "type": "string",
          "enum": [
            "makecode",
            "blockly"
          ],
          "enumDescriptions": [
            "Embed the real MakeCode Arcade editor. Every block, the image and tilemap editors and the simulator are the genuine ones. Requires access to arcade.makecode.com.",
            "Use the built-in Blockly editor. Works with no network access, and merges simultaneous edits more finely, but does not include MakeCode’s tilemap, melody or grid editors."
          ],
          "default": "makecode",
          "description": "Which editor to draw .blocks files with."
        }
      }
    }
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "compile": "npm run vendor && node esbuild.mjs",
    "watch": "npm run vendor && node esbuild.mjs --watch",
    "package": "npm run vendor && node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "open-in-browser": "npm run compile && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ./sample",
    "test": "npm run compile && node test/roundtrip.mjs",
    "arcade:refresh": "node scripts/fetchArcade.mjs && node scripts/generateArcadeBlocks.mjs",
    "probe:embed": "node probe/serve.mjs",
    "test:collab": "node collab/test/syncState.test.mjs && node collab/test/arcadeProtocol.test.mjs",
    "vsix": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.2.0",
    "blockly": "^13.3.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
