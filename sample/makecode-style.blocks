<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable type="" id="counter">counter</variable>
  </variables>
  <block type="device_forever" id="forever1" x="40" y="40">
    <statement name="HANDLER">
      <block type="basic_show_number" id="show1">
        <value name="number">
          <shadow type="math_number" id="num1">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
</xml>
